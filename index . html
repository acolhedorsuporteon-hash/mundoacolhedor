<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mundo Acolhedor · Guia para ajudar o autista a se adaptar às rotinas</title>
<meta name="description" content="Guia prático para mães, pais e cuidadores de autistas: rotinas mais leves, menos crises e mais previsibilidade no dia a dia. R$ 29,99.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;900&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root {
    --azul: #3A86FF;
    --verde: #06D6A0;
    --amarelo: #FFD166;
    --laranja: #FF7A59;
    --roxo: #8338EC;
    --rosa: #FF5C8A;
    --navy: #1B1B3A;
    --texto: #2A2A4A;
    --cinza: #6A6A85;
    --fundo: #FBFAFF;
    --branco: #FFFFFF;
    --grad: linear-gradient(90deg, var(--azul), var(--verde), var(--amarelo), var(--laranja), var(--rosa), var(--roxo));
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: "Nunito", "Segoe UI", Arial, sans-serif;
    color: var(--texto);
    background: var(--fundo);
    line-height: 1.6;
    font-size: 17px;
  }
  h1, h2, h3, .display { font-family: "Poppins", "Segoe UI", Arial, sans-serif; color: var(--navy); line-height: 1.15; letter-spacing: -0.01em; }
  h1 { font-size: clamp(34px, 5.4vw, 60px); font-weight: 900; margin: 0 0 18px; }
  h2 { font-size: clamp(28px, 4vw, 42px); font-weight: 900; margin: 0 0 14px; text-align: center; }
  h3 { font-size: 20px; font-weight: 700; margin: 0 0 8px; }
  p { margin: 0 0 14px; }
  .container { max-width: 1140px; margin: 0 auto; padding: 0 22px; }
  section { padding: 84px 0; position: relative; }
  .eyebrow {
    display: inline-block; font-family: "Poppins", Arial, sans-serif; font-weight: 700; font-size: 13px;
    letter-spacing: .12em; text-transform: uppercase; color: var(--roxo);
    background: #EFE7FF; padding: 7px 14px; border-radius: 999px; margin-bottom: 14px;
  }
  .sub-center { text-align: center; max-width: 720px; margin: 0 auto 40px; color: var(--cinza); font-size: 18px; }

  /* Botões */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    font-family: "Poppins", Arial, sans-serif; font-weight: 700; font-size: 17px;
    text-decoration: none; color: #fff; background: var(--laranja);
    padding: 18px 34px; border-radius: 16px;
    box-shadow: 0 10px 0 #d95f3c, 0 18px 30px rgba(255,122,89,.35);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover { transform: translateY(-3px); box-shadow: 0 13px 0 #d95f3c, 0 22px 34px rgba(255,122,89,.4); }
  .btn:active { transform: translateY(6px); box-shadow: 0 4px 0 #d95f3c; }
  .btn.branco { background: #fff; color: var(--roxo); box-shadow: 0 10px 0 rgba(0,0,0,.12); }
  .btn.branco:hover { box-shadow: 0 13px 0 rgba(0,0,0,.12); }

  /* Barra de anúncio */
  .topo {
    background: var(--navy); color: #fff; text-align: center; padding: 10px 16px;
    font-family: "Poppins", Arial, sans-serif; font-size: 13px; font-weight: 600;
  }
  .topo span { color: var(--amarelo); }

  /* Cabeçalho */
  nav.menu {
    position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.92); backdrop-filter: blur(8px);
    border-bottom: 1px solid #ECE8F7;
  }
  nav.menu .container { display: flex; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: "Poppins", Arial, sans-serif; font-weight: 900; color: var(--navy); font-size: 18px; }
  .logo svg { width: 42px; height: 42px; }
  nav.menu .links { display: flex; gap: 26px; align-items: center; }
  nav.menu .links a { text-decoration: none; color: var(--texto); font-weight: 600; font-size: 15px; }
  nav.menu .links a:hover { color: var(--roxo); }
  @media (max-width: 860px) { nav.menu .links a:not(.btn) { display: none; } }
  nav.menu .btn { padding: 12px 20px; font-size: 15px; box-shadow: 0 5px 0 #d95f3c; }
  nav.menu .btn:hover { transform: none; }

  /* Hero */
  .hero {
    background: linear-gradient(180deg, #DDF3FA 0%, #F3FBFE 100%);
    padding: 80px 0 90px; overflow: hidden;
  }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; align-items: center; }
  .hero h1 span.destaque {
    background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero .lead { font-size: 20px; color: var(--cinza); max-width: 560px; margin-bottom: 30px; }
  .hero .cta-linha { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
  .hero .prova { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 10px; }
  .chip {
    background: #fff; border: 2px solid #ECE8F7; border-radius: 999px; padding: 8px 14px;
    font-weight: 700; font-size: 14px; color: var(--navy);
    font-family: "Poppins", Arial, sans-serif;
  }
  .chip b { color: var(--verde); }

  .hero-arte { position: relative; display: flex; justify-content: center; }
  .hero-arte .cartao {
    background: #fff; border-radius: 28px; padding: 22px; box-shadow: 0 30px 60px rgba(27,27,58,.18);
    transform: rotate(-2deg); max-width: 380px; width: 100%;
  }
  .hero-arte .cartao svg { width: 100%; height: auto; display: block; border-radius: 18px; }
  .hero-arte .selo-flutuante {
    position: absolute; right: -6px; bottom: 26px; background: var(--amarelo); color: var(--navy);
    font-family: "Poppins", Arial, sans-serif; font-weight: 800; font-size: 15px;
    padding: 14px 18px; border-radius: 18px; transform: rotate(4deg); box-shadow: 0 14px 26px rgba(0,0,0,.15);
  }

  /* Dor */
  .dor { background: #fff; }
  .dor-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; }
  .card {
    background: #fff; border-radius: 24px; padding: 28px; border: 2px solid #F0ECFA;
    box-shadow: 0 12px 26px rgba(27,27,58,.06); transition: transform .2s ease;
  }
  .card:hover { transform: translateY(-5px); }
  .card .ico {
    width: 58px; height: 58px; border-radius: 18px; display: grid; place-items: center;
    font-size: 28px; margin-bottom: 16px;
  }
  .c1 .ico { background: #E3EEFF; }
  .c2 .ico { background: #DDFBF2; }
  .c3 .ico { background: #FFF3CC; }
  .c4 .ico { background: #FFE2EC; }
  .c5 .ico { background: #EEE3FF; }
  .c6 .ico { background: #FFE6DD; }
  .card p { color: var(--cinza); margin: 0; }

  /* Benefícios */
  .beneficios { background: var(--fundo); }
  .benef-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
  .benef {
    display: flex; gap: 16px; align-items: flex-start; background: #fff; border-radius: 20px; padding: 20px 22px;
    border: 2px solid #F0ECFA;
  }
  .benef .n {
    flex: 0 0 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; color: #fff;
    font-family: "Poppins", Arial, sans-serif; font-weight: 800; font-size: 17px;
  }
  .benef:nth-child(6n+1) .n { background: var(--azul); }
  .benef:nth-child(6n+2) .n { background: var(--verde); }
  .benef:nth-child(6n+3) .n { background: var(--amarelo); color: var(--navy); }
  .benef:nth-child(6n+4) .n { background: var(--laranja); }
  .benef:nth-child(6n+5) .n { background: var(--rosa); }
  .benef:nth-child(6n+6) .n { background: var(--roxo); }
  .benef p { margin: 0; color: var(--texto); }

  /* Capítulos */
  .capitulos { background: var(--navy); color: #fff; }
  .capitulos h2, .capitulos h3 { color: #fff; }
  .capitulos .sub-center { color: #B9B8D4; }
  .cap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .cap {
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 20px; padding: 20px 22px;
    display: flex; gap: 14px; align-items: center;
  }
  .cap .num { font-family: "Poppins", Arial, sans-serif; font-weight: 900; font-size: 26px; color: var(--amarelo); min-width: 44px; }
  .cap span.t { font-weight: 700; }

  /* Para quem */
  .para-quem-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px; }
  .pessoa {
    border-radius: 24px; padding: 28px 24px; color: #fff; min-height: 180px;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .pessoa h3 { color: #fff; font-size: 19px; }
  .pessoa p { color: rgba(255,255,255,.92); margin: 0; font-size: 15px; }
  .pessoa.p1 { background: linear-gradient(135deg, #3A86FF, #5BA4FF); }
  .pessoa.p2 { background: linear-gradient(135deg, #06D6A0, #2EC4A0); }
  .pessoa.p3 { background: linear-gradient(135deg, #8338EC, #A66BFF); }
  .pessoa.p4 { background: linear-gradient(135deg, #FF7A59, #FF5C8A); }

  /* Oferta */
  .oferta { background: #fff; }
  .oferta-box {
    max-width: 640px; margin: 0 auto; border-radius: 32px; overflow: hidden;
    border: 3px solid transparent;
    background: linear-gradient(#fff,#fff) padding-box, var(--grad) border-box;
    box-shadow: 0 30px 60px rgba(27,27,58,.12);
  }
  .oferta-topo {
    background: var(--grad); color: #fff; text-align: center; padding: 14px;
    font-family: "Poppins", Arial, sans-serif; font-weight: 800; letter-spacing: .04em; font-size: 15px;
  }
  .oferta-corpo { padding: 38px 34px; text-align: center; }
  .oferta-corpo .de { color: var(--cinza); text-decoration: line-through; font-size: 17px; }
  .oferta-corpo .por {
    font-family: "Poppins", Arial, sans-serif; font-weight: 900; font-size: 72px; line-height: 1; color: var(--navy); margin: 8px 0 4px;
  }
  .oferta-corpo .por small { font-size: 26px; vertical-align: top; position: relative; top: 12px; margin-right: 4px; }
  .oferta-corpo ul { list-style: none; padding: 0; margin: 22px 0 26px; text-align: left; display: inline-block; }
  .oferta-corpo li { padding: 6px 0 6px 30px; position: relative; font-weight: 600; }
  .oferta-corpo li::before {
    content: "✓"; position: absolute; left: 0; top: 6px; width: 20px; height: 20px; border-radius: 50%;
    background: var(--verde); color: #fff; text-align: center; line-height: 20px; font-size: 12px; font-weight: 900;
  }
  .oferta-corpo .formas { color: var(--cinza); font-size: 14px; margin-top: 16px; }
  .oferta-corpo .seguranca { color: var(--cinza); font-size: 14px; margin-top: 8px; }

  /* Garantia */
  .garantia { background: var(--fundo); }
  .garantia-box {
    display: flex; gap: 26px; align-items: center; max-width: 860px; margin: 0 auto;
    background: #fff; border-radius: 28px; padding: 30px 34px; border: 2px solid #F0ECFA;
  }
  .garantia-box .sel {
    flex: 0 0 90px; height: 90px; border-radius: 50%; display: grid; place-items: center;
    background: var(--verde); color: #fff; font-family: "Poppins", Arial, sans-serif; font-weight: 900; font-size: 26px;
  }
  .garantia-box p { margin: 0; color: var(--cinza); }



  /* Cenário da dor */
  .cenario { background: linear-gradient(180deg, #1B1B3A 0%, #2A2360 100%); color: #fff; }
  .cenario h2 { color: #fff; }
  .cenario .eyebrow { background: rgba(255,255,255,.12); color: #FFD166; }
  .cena-hora { font-family: "Poppins", Arial, sans-serif; font-weight: 900; font-size: 15px; letter-spacing: .08em; color: #FFD166; text-transform: uppercase; margin-bottom: 6px; }
  .cena-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; margin-top: 40px; }
  .cena-texto p { color: #DCD9F0; font-size: 18px; }
  .cena-texto p strong { color: #fff; }
  .cena-linha { border-left: 3px solid #FF7A59; padding: 4px 0 4px 20px; margin: 22px 0; }
  .cena-linha .cena-hora { color: #FF7A59; }
  .cena-frase { font-family: "Poppins", Arial, sans-serif; font-weight: 800; font-size: 22px; color: #fff; line-height: 1.35; margin: 26px 0 0; }
  .cena-svg { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 28px; padding: 18px; }
  .cena-svg svg { width: 100%; height: auto; display: block; }
  .cena-legenda { text-align: center; color: #B9B8D4; font-size: 14px; margin-top: 12px; }
  .cena-final { text-align: center; margin-top: 56px; }
  .cena-final p { color: #DCD9F0; font-size: 19px; max-width: 680px; margin: 0 auto 26px; }
  @media (max-width: 860px) { .cena-grid { grid-template-columns: 1fr; } }




  /* Suporte flutuante dinâmico (desktop e celular) */
  .suporte-wrap { position: fixed; right: 22px; bottom: 22px; z-index: 55; font-family: "Poppins", Arial, sans-serif; }
  .suporte-btn {
    position: relative; display: flex; align-items: center; gap: 10px; cursor: pointer; border: 0;
    background: var(--verde); color: #fff; font-family: inherit; font-weight: 700; font-size: 15px;
    padding: 14px 20px 14px 16px; border-radius: 999px; box-shadow: 0 10px 24px rgba(27,27,58,.28);
    transition: transform .15s ease;
  }
  .suporte-btn:hover { transform: translateY(-2px); }
  .suporte-btn svg { width: 24px; height: 24px; flex: 0 0 24px; }
  .suporte-btn::before {
    content: ""; position: absolute; inset: -6px; border-radius: 999px; border: 3px solid var(--verde);
    opacity: .6; animation: pulso 2s ease-out infinite; pointer-events: none;
  }
  @keyframes pulso { 0% { transform: scale(.95); opacity: .7; } 100% { transform: scale(1.25); opacity: 0; } }
  .suporte-painel {
    position: absolute; right: 0; bottom: 68px; width: 290px; background: #fff; color: var(--texto);
    border-radius: 20px; padding: 20px; box-shadow: 0 20px 44px rgba(27,27,58,.25); border: 2px solid #F0ECFA;
    opacity: 0; transform: translateY(10px) scale(.98); pointer-events: none; transition: opacity .2s ease, transform .2s ease;
  }
  .suporte-wrap.aberto .suporte-painel { opacity: 1; transform: none; pointer-events: auto; }
  .suporte-wrap.aberto .suporte-btn::before { animation: none; opacity: 0; }
  .suporte-painel h4 { margin: 0 0 6px; color: var(--navy); font-size: 16px; font-weight: 800; }
  .suporte-painel p { margin: 0 0 14px; font-size: 14px; color: var(--cinza); line-height: 1.45; }
  .suporte-painel .email { font-size: 13px; font-weight: 700; color: var(--roxo); word-break: break-all; margin-bottom: 12px; display: block; }
  .suporte-acoes { display: grid; gap: 8px; }
  .suporte-acoes a, .suporte-acoes button {
    display: block; text-align: center; text-decoration: none; font-family: inherit; font-weight: 700; font-size: 14px;
    padding: 11px; border-radius: 12px; border: 0; cursor: pointer;
  }
  .suporte-acoes .enviar { background: var(--roxo); color: #fff; }
  .suporte-acoes .copiar { background: #EFE7FF; color: var(--roxo); }
  .suporte-acoes .copiar.ok { background: var(--verde); color: #fff; }
  .suporte-fechar {
    position: absolute; top: 8px; right: 12px; background: none; border: 0; font-size: 22px; color: var(--cinza); cursor: pointer;
  }
  @media (max-width: 860px) {
    .suporte-wrap { right: 14px; bottom: 92px; }
    .suporte-btn { padding: 0; width: 56px; height: 56px; justify-content: center; border-radius: 50%; }
    .suporte-btn span.txt { display: none; }
    .suporte-painel { width: min(290px, calc(100vw - 28px)); right: 0; }
  }
  @media (min-width: 861px) {
    .suporte-btn span.txt { display: inline; }
  }

  /* FAQ */
  .faq { background: var(--fundo); }
  .faq-lista { max-width: 800px; margin: 0 auto; display: grid; gap: 12px; }
  .faq-item { background: #fff; border-radius: 18px; padding: 18px 22px; border: 2px solid #F0ECFA; }
  .faq-item summary {
    cursor: pointer; font-family: "Poppins", Arial, sans-serif; font-weight: 700; color: var(--navy); list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .faq-item summary::after { content: "+"; font-size: 24px; color: var(--roxo); font-weight: 900; }
  .faq-item[open] summary::after { content: "–"; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { margin: 12px 0 0; color: var(--cinza); }

  /* Aviso */
  .aviso { background: #fff; }
  .aviso-box {
    max-width: 820px; margin: 0 auto; background: #FFF8E6; border-radius: 20px; padding: 20px 24px;
    border-left: 6px solid var(--amarelo); font-size: 15px; color: #5B5440;
  }

  /* CTA final */
  .cta-final {
    background: linear-gradient(120deg, var(--azul), var(--roxo) 50%, var(--rosa));
    color: #fff; text-align: center; padding: 96px 0;
  }
  .cta-final h2 { color: #fff; }
  .cta-final p { color: rgba(255,255,255,.92); font-size: 19px; max-width: 620px; margin: 0 auto 30px; }

  /* Rodapé */
  footer { background: var(--navy); color: #B9B8D4; padding: 48px 0 30px; font-size: 14px; }
  footer .links { display: flex; flex-wrap: wrap; gap: 18px 28px; justify-content: center; margin-bottom: 18px; }
  footer a { color: #fff; text-decoration: none; font-weight: 600; }
  footer a:hover { color: var(--amarelo); }
  footer .legal { text-align: center; margin: 0; font-size: 13px; }

  /* Barra fixa no celular */
  .fixo-mobile { display: none; }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero .lead { margin-left: auto; margin-right: auto; }
    .hero .cta-linha, .hero .prova { justify-content: center; }
    .hero-arte .cartao { transform: none; max-width: 300px; }
    .hero-arte .selo-flutuante { right: 0; }
    section { padding: 60px 0; }
    .garantia-box { flex-direction: column; text-align: center; }
    .fixo-mobile {
      display: block; position: fixed; bottom: 0; left: 0; right: 0; z-index: 60;
      background: #fff; padding: 12px 16px; box-shadow: 0 -8px 24px rgba(27,27,58,.12);
    }
    .fixo-mobile .btn { width: 100%; font-size: 16px; padding: 15px; }
    body { padding-bottom: 86px; }
  }

  /* ===== Ajustes responsivos (desktop e celular) ===== */
  img { max-width: 100%; height: auto; }
  body { overflow-x: hidden; }
  .btn { max-width: 100%; text-align: center; }
  .oferta-box, .garantia-box, .aviso-box, .depo-vazio { max-width: 100%; }

  @media (max-width: 1024px) {
    .container { padding: 0 24px; }
    .hero-grid { gap: 36px; }
    .cap-grid, .benef-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    nav.menu .container { padding-top: 10px; padding-bottom: 10px; }
    nav.menu .btn { padding: 10px 16px; font-size: 14px; }
    .logo { font-size: 16px; }
    .logo svg { width: 36px; height: 36px; }
    .cena-grid, .hero-grid { gap: 28px; }
    .benef-grid, .cap-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    html { font-size: 16px; }
    body { font-size: 16px; }
    .container { padding: 0 18px; }
    section { padding: 48px 0; }
    .hero { padding: 48px 0 56px; }
    h1 { font-size: 32px; }
    h2 { font-size: 26px; }
    .hero .lead { font-size: 17px; }
    .topo { font-size: 12px; line-height: 1.4; }
    .eyebrow { font-size: 11px; }
    .hero .cta-linha { width: 100%; }
    .hero .cta-linha .btn { width: 100%; }
    .hero .prova { gap: 8px; }
    .chip { font-size: 12px; padding: 6px 10px; }
    .hero-arte .selo-flutuante { font-size: 13px; padding: 10px 14px; }
    .card, .pessoa { padding: 22px; }
    .cena-frase { font-size: 19px; }
    .cena-texto p { font-size: 16px; }
    .oferta-corpo { padding: 28px 20px; }
    .oferta-corpo .por { font-size: 60px; }
    .oferta-corpo .btn { width: 100%; }
    .oferta-corpo li { font-size: 15px; }
    .garantia-box { padding: 22px; }
    .cta-final { padding: 64px 0; }
    .cta-final .btn { width: 100%; }
    .faq-item summary { font-size: 15px; }
    footer .links { flex-direction: column; gap: 12px; }
    .suporte { width: 48px; height: 48px; }
  }

  @media (min-width: 1400px) {
    .container { max-width: 1240px; }
  }
</style>
</head>
<body>

<div class="topo">Acesso imediato após a compra · Pagamento 100% seguro · <span>Garantia de 7 dias</span></div>

<nav class="menu">
  <div class="container">
    <a class="logo" href="#topo" aria-label="Mundo Acolhedor">
